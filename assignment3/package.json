    "openapi-backend": "^5.11.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/swagger-ui-express": "^4.1.7",
    "openapi-typescript": "^7.4.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
