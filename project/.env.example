# PostgreSQL (로컬 또는 Docker)
# - DATABASE_URL: 앱 런타임용 (예: Supabase pooler)
# - DIRECT_URL: Prisma migrate/introspect용 direct 연결
# docker compose 사용 시: .env에 localhost만 넣어두면 컨테이너 안에서는 DB가 아닙니다.
#   compose 기본값(postgres 호스트)을 쓰려면 이 두 줄을 비우거나, 호스트를 postgres 로 두세요.
# Supabase 등 원격 URL이면 컨테이너에서도 그대로 사용 가능합니다.
DATABASE_URL=postgresql://tubedeck:tubedeck@localhost:5432/tubedeck
DIRECT_URL=postgresql://tubedeck:tubedeck@localhost:5432/tubedeck

# 외부 API (명세: YouTube + OpenAI)
YOUTUBE_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Auth.js (Next.js) — empty Google IDs → /api/auth/error?error=Configuration
# Use a long random AUTH_SECRET (e.g. openssl rand -base64 32)
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional aliases from Google Cloud Console:
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
NEXTAUTH_URL=http://localhost:3000

# 서비스 URL
# - Host에서 web만 `npm run dev` 할 때: 아래처럼 localhost 사용
# - Docker Compose의 web 컨테이너는 compose에서 http://auth-service:4001 로 고정됨(.env의 이 값은 무시됨)
AUTH_SERVICE_URL=http://127.0.0.1:4001
QUEUE_SERVICE_URL=http://127.0.0.1:4002
VIDEO_SERVICE_URL=http://127.0.0.1:4003
ANALYSIS_SERVICE_URL=http://127.0.0.1:4004
ANALYTICS_SERVICE_URL=http://127.0.0.1:4005
GATEWAY_URL=http://127.0.0.1:4000

# Next → Gateway 프록시 검증 (선택)
GATEWAY_TRUST_PROXY_SECRET=
