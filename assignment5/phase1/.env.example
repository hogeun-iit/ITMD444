# Supabase / PostgreSQL
# Pooler (e.g. 6543) for app + pgbouncer; direct 5432 for migrations.
DATABASE_URL="postgresql://USER:PASS@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://USER:PASS@HOST:5432/postgres?sslmode=require"

# Optional: YouTube Data API for real metadata on `POST /videos` (else mock titles)
# YOUTUBE_API_KEY=

# Session signing ? must be กร32 chars; required in production (`NODE_ENV=production`).
SESSION_SECRET="replace-with-a-random-string-at-least-32-characters-long"

LOG_LEVEL=info
HOST=0.0.0.0
PORT=3000
