generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  fullName  String   @map("full_name")
  createdAt DateTime @default(now()) @map("created_at")

  decks Deck[]

  @@index([email])
  @@map("users")
}

model Deck {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  videos Video[]

  @@index([userId])
  @@map("decks")
}

model Video {
  id               String    @id @default(uuid())
  deckId           String    @map("deck_id")
  deck             Deck      @relation(fields: [deckId], references: [id], onDelete: Cascade)
  youtubeVideoId   String    @map("youtube_video_id")
  title            String
  description      String    @default("")
  channelTitle     String    @default("") @map("channel_title")
  thumbnailUrl     String?   @map("thumbnail_url")
  durationSec      Int?      @map("duration_sec")
  publishedAt      DateTime? @map("published_at")
  transcriptStatus String    @default("METADATA_ONLY") @map("transcript_status")
  archived         Boolean   @default(false)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  analysis VideoAnalysis?

  @@unique([deckId, youtubeVideoId])
  @@index([deckId])
  @@index([archived])
  @@map("videos")
}

model VideoAnalysis {
  id           String   @id @default(uuid())
  videoId      String   @unique @map("video_id")
  video        Video    @relation(fields: [videoId], references: [id], onDelete: Cascade)
  summary      String?
  keyTakeaways String?  @map("key_takeaways")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("video_analyses")
}
