{
  "name": "assignment4-task-tracker-api",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "generate:types": "openapi-typescript openapi/openapi.yaml -o src/types/generated.ts",
    "dev": "ts-node src/server.ts",
    "prebuild": "npm run generate:types && prisma generate",
    "build": "tsc",
    "start": "node dist/server.js",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:push": "prisma db push",
    "generate:client": "openapi-generator-cli generate -g typescript-fetch -i openapi/openapi.yaml -o ../generated-client --additional-properties supportsES6=true,typescriptThreePlus=true"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "openapi-backend": "^5.11.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.25.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/swagger-ui-express": "^4.1.7",
    "openapi-typescript": "^7.4.4",
    "prisma": "5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
