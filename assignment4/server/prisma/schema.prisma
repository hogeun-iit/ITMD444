generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime: Supabase on Render → use Transaction pooler (port 6543) + ?pgbouncer=true
  url       = env("DATABASE_URL")
  // Migrations: direct DB connection (port 5432). Local dev: can match DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model Task {
  id             String       @id
  title          String
  assignee       String
  status         TaskStatus
  priority       TaskPriority
  estimateHours  Int          @map("estimate_hours")
  dueDate        DateTime     @map("due_date")

  @@map("tasks")
}
